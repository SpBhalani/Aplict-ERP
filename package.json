{
  "name": "platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify:quick": "tsx tools/arch-checks/src/verify.ts",
    "verify:full": "nx run-many -t lint typecheck test --output-style=static && pnpm -s arch:check && pnpm -s contracts:check && pnpm -s tests:verify-lock",
    "arch:check": "tsx tools/arch-checks/src/run.ts",
    "contracts:check": "tsx tools/arch-checks/src/contracts.ts check",
    "contracts:snapshot": "tsx tools/arch-checks/src/contracts.ts snapshot",
    "tests:lock": "tsx tools/arch-checks/src/tests-lock.ts lock",
    "tests:verify-lock": "tsx tools/arch-checks/src/tests-lock.ts verify",
    "task:start": "tsx tools/arch-checks/src/task.ts start",
    "task:done": "tsx tools/arch-checks/src/task.ts done",
    "module-map": "tsx tools/arch-checks/src/module-map.ts write",
    "hooks:test": "node .claude/hooks/test-hooks.mjs",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@nx/devkit": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "@types/node": "^22.10.0",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "jsonc-eslint-parser": "^2.4.0",
    "lefthook": "^2.1.17",
    "nx": "23.2.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "@platform/tools": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
