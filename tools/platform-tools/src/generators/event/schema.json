{
  "$schema": "https://json-schema.org/schema",
  "$id": "PlatformEvent",
  "title": "Create an event contract",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Past tense as module.something-happened, e.g. quote.revision-approved",
      "$default": { "$source": "argv", "index": 0 }
    },
    "version": { "type": "number", "default": 1 },
    "description": { "type": "string", "default": "TODO: when this event is published" }
  },
  "required": ["name"]
}
